# 运行时产物（预测 / 复盘 / 报告 / 历史，每次运行自动再生，不入库）
data/predictions_*.json
data/summary_*.json
data/day_review_*.json
data/reconcile_*.json
data/validation_metrics_*.json
data/analysis_*.json
data/a_stock_*.json
data/accuracy_history.json
data/clean_*.json
data/consistent_*.json
data/*_predictions.json
data/*_report_*.json
data/top5_*.json
data/accuracy_*.json
reports/
logs/
*.log
pids/
predictions.db

# 保留：仅调优参数入库（calibration_overrides.json 供 auto_calibration 读取，需跨克隆保留）
!config/calibration_overrides.json
# 忽略：loop 中间过程（每次运行自动再生，非调优参数，无需入库）
data/iteration_state.json
# iteration_briefing.txt 已被上方 *.txt 规则忽略
# 保留：reconcile_history.jsonl 是准确率记分牌（append-only 小文件，跨克隆需保留）
!data/reconcile_history.jsonl

# 根目录 txt（保留 requirements.txt）
*.txt
!requirements.txt
